<?xml version='1.0' ?>
<sdf version='1.9'>
  <model name="jetbot">
    <plugin filename="libignition-gazebo-navsat-system.so"
            name="ignition::gazebo::systems::NavSat">
    </plugin>
    <static>false</static>
    <link name="link">
      <sensor type="navsat" name="gps">
        <navsat>
          <position_sensing>
          </position_sensing>
        </navsat>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/jetbot/gps</topic>
      </sensor>
      <sensor type="camera" name="camera">
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/jetbot/camera</topic>
        <pose>0 0.0 0.9 0 0 3.154</pose>
      </sensor>
      <collision name="collision">
        <geometry>
          <mesh>
            <scale>10 10 10</scale>
            <uri>model://gazebo_jetbot/meshes/jetbot_v1.obj</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <scale>10 10 10</scale>
            <uri>model://gazebo_jetbot/meshes/jetbot_v1.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <inertial>
        <mass>10</mass>
        <pose>0 -0.5 -0.2 0 0 0</pose>
      </inertial>
    </link>
  </model>
</sdf>
